{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OJJIPA",
  "version": "0.1.0",
  "identifier": "com.admin.desktop",
  "build": {
    "additionalWatchFolders": ["../../../engine/python", "../../../core/grandpa", "../../../core/minipa", "../../../core/hermes"],
    "beforeDevCommand": "node scripts/prepare-runtime.mjs --development && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:runtime && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OJJIPA",
        "width": 1200,
        "height": 800,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "resources": {"resources/runtime/": "runtime/"},
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
